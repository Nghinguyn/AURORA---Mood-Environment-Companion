<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/deep_night_blue</item>
        <item name="android:textColor">@color/soft_white</item>
    </style>

    // LIGHT/DARK theme button
    <style name="AuroraButton.Light" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/aurora_green</item>
        <item name="android:textColor">@color/deep_night_blue</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="AuroraButton.Dark" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/violet_glow</item>
        <item name="android:textColor">@color/soft_white</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Base Aurora Button Style -->
    <style name="AuroraButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>