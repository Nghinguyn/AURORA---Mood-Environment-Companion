<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reflectionLayout"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aurora_gradient_dark">

    <TextView
        android:id="@+id/reflectionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your uplifting reflection will appear here"
        android:textColor="@color/soft_white"
        android:textSize="18sp"
        android:gravity="center"
        />

    <Button
        android:id="@+id/shareButton"
        style="@style/AuroraButton"
        android:text="Share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/viewJourneyButton"
        style="@style/AuroraButton"
        android:text="View Journey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

</LinearLayout>
