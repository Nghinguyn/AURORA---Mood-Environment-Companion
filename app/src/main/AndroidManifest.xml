<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.aurora">

    <application
        android:label="Aurora"
        android:theme="@style/Theme.AURORA">

        <!-- HomeActivity is the launcher activity -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Declaration for JournalWriteActivity -->
        <activity
            android:name=".JournalWriteActivity"
            android:exported="true" />

        <!-- Declaration for JourneyActivity -->
        <activity
            android:name=".JourneyActivity"
            android:exported="true" />

        <!-- Declaration for ReflectionActivity -->
        <activity
            android:name=".ReflectionActivity"
            android:exported="true" />

    </application>

</manifest>
